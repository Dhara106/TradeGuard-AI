# ============================================
# Root .env — optional overrides for docker compose
# Copy to ".env" (same folder as docker-compose.yml) and fill in.
# Everything here is OPTIONAL; the stack runs with defaults if omitted.
# ============================================

# Secret used to sign JWTs (change this for any real deployment)
JWT_SECRET=tradeguard_super_secret_key_2026

# Host ports. Override if a local dev server already occupies the default.
# The frontend (Vite) commonly uses 5173 and the Node backend 5000 in local dev,
# so the API defaults to 5001 here to avoid a clash. Internal container ports
# are unchanged, so service-to-service traffic is unaffected.
FRONTEND_HOST_PORT=5173
API_HOST_PORT=5001

# Gmail credentials for outbound email (verification, alerts, etc.).
# Leave blank to run without email — those features simply no-op.
# For Gmail use an "App Password", not your normal password.
EMAIL_USER=
EMAIL_PASS=
